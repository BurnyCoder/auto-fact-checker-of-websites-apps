{
  "manifest_version": 3,
  "name": "Fact Check What You See",
  "version": "0.1.0",
  "description": "Underlines factual claims on web pages with verdicts, confidence, corrections and sources from the local fact-check app.",
  "key": "",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service_worker.js" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Fact check" },
  "options_page": "options.html",
  "commands": {
    "check-page": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Fact-check the visible part of this page now" }
  }
}
