# --- Secrets: never commit (holds ANTHROPIC_API_KEY etc.) ---
.env
.env.*
!.env.example

# --- Python / uv ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

